function generateQuestion() {
    const c = Math.floor(Math.random() * 9) + 1; // Random y-intercept from 1 to 9
    const questionText = `Identify the graph for g(x) = x² + ${c}`;
    const correctVertex = [0, c];
    
    // Programmatically generate correct and wrong answer choices
    const choices = [
        { id: 'correct', vertex: [0, c], text: `Graph with vertex at (0, ${c})` },
        { id: 'wrong1', vertex: [-c, 0], text: `Graph with vertex at (-${c}, 0)` },
        { id: 'wrong2', vertex: [0, -c], text: `Graph with vertex at (0, -${c})` }
    ];
    
    return { questionText, choices: shuffle(choices) };
}
